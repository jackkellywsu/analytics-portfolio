---
/**
 * Site shell: masthead, nav, persistent resume download, footer.
 *
 * SPEC.md 7 requires the resume to download in one click from anywhere on the site,
 * so the button lives in the sticky masthead rather than on a single page.
 */
import { existsSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/', label: 'Overview' },
  { href: '/targeting', label: 'Targeting Engine' },
  { href: '/semantic-layer', label: 'Semantic Layer' },
  { href: '/about', label: 'About' },
];

// Never ship a link to a file that is not there. If the PDF has not been added yet
// the control renders as plainly unavailable instead of 404-ing a hiring manager.
const publicDir = join(dirname(fileURLToPath(import.meta.url)), '..', '..', 'public');
const hasResume = existsSync(join(publicDir, 'resume.pdf'));
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="masthead">
      <div class="shell masthead-inner">
        <a class="wordmark" href="/">Jack Kelly</a>
        <nav aria-label="Primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        {
          hasResume ? (
            <a class="resume-btn" href="/resume.pdf" download>
              Download resume (PDF)
            </a>
          ) : (
            <span class="pill pill-pending" title="resume.pdf not yet added to site/public/">
              Resume PDF pending
            </span>
          )
        }
      </div>
    </header>

    <main class="shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <p>
          Built with real USPTO data. Every figure on this site traces to a provenance
          record in the repository, and the code that produced it is public.
        </p>
        <p>
          &copy; {year} Jack Kelly &middot;{' '}
          <a href="https://github.com/jackkellywsu">Source on GitHub</a>
        </p>
      </div>
    </footer>
  </body>
</html>
