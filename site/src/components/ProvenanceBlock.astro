---
/**
 * The provenance block required on every project page by SPEC.md 1.4:
 * source name, endpoint or file, query parameters, date pulled, record count,
 * and known gaps.
 *
 * Reads a record generated by pipeline/provenance.py. Nothing here is hand-written,
 * so the block cannot fall out of step with the data it describes. When the record
 * is absent the component says so plainly rather than rendering an empty shell --
 * an unacquired source is a fact worth showing, not a gap to paper over.
 */
import { formatBytes, formatCount, formatDate, type Provenance } from '../lib/data';

export interface Props {
  record: Provenance | null;
  /** What the source is for, shown when the record has not been generated yet. */
  pendingLabel?: string;
  pendingNote?: string;
}

const { record, pendingLabel = 'Source not yet acquired', pendingNote } = Astro.props;
---

{
  record ? (
    <section class="provenance" aria-label="Data provenance">
      <header class="provenance-head">
        <span class="callout-label">Data provenance</span>
        <h3>{record.source_name}</h3>
      </header>

      <dl class="provenance-grid">
        <div>
          <dt>Location</dt>
          <dd>
            <a href={record.source_url}>{record.source_url}</a>
          </dd>
        </div>
        <div>
          <dt>Access method</dt>
          <dd>{record.access_method}</dd>
        </div>
        <div>
          <dt>Release / version</dt>
          <dd>{record.release_version ?? 'not recorded'}</dd>
        </div>
        <div>
          <dt>Retrieved</dt>
          <dd>
            <time datetime={record.retrieved_at}>{formatDate(record.retrieved_at)}</time>
          </dd>
        </div>
      </dl>

      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">File</th>
              <th scope="col">Table</th>
              <th scope="col">Records</th>
              <th scope="col">Size</th>
              <th scope="col">SHA-256</th>
            </tr>
          </thead>
          <tbody>
            {record.files.flatMap((file) =>
              file.tables.map((table, i) => (
                <tr>
                  {i === 0 && (
                    <td rowspan={file.tables.length}>
                      <code>{file.filename}</code>
                    </td>
                  )}
                  <td>
                    <code>{table.table}</code>
                  </td>
                  <td>{formatCount(table.record_count)}</td>
                  {i === 0 && <td rowspan={file.tables.length}>{formatBytes(file.size_bytes)}</td>}
                  {i === 0 && (
                    <td rowspan={file.tables.length}>
                      <code class="hash">{file.sha256.slice(0, 12)}…</code>
                    </td>
                  )}
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      {record.known_gaps.length > 0 && (
        <div class="callout callout-warn">
          <span class="callout-label">Known gaps in this source</span>
          <ul>
            {record.known_gaps.map((gap) => (
              <li>{gap}</li>
            ))}
          </ul>
        </div>
      )}

      {record.notes.length > 0 && (
        <ul class="provenance-notes">
          {record.notes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
      )}
    </section>
  ) : (
    <section class="provenance provenance-pending" aria-label="Data provenance">
      <span class="callout-label">Data provenance</span>
      <h3>{pendingLabel}</h3>
      <p>
        {pendingNote ??
          'This source has not been acquired yet, so there is no provenance record to show. Rather than display placeholder figures, this section stays empty until real data is in hand.'}
      </p>
    </section>
  )
}

<style>
  .provenance {
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    padding: 1.5rem;
    margin: 2.5rem 0;
    background: var(--paper-raised);
  }

  .provenance-head h3,
  .provenance-pending h3 {
    margin: 0.15rem 0 1rem;
    font-size: 1.15rem;
  }

  .provenance-pending {
    border-style: dashed;
  }

  .provenance-pending p {
    color: var(--ink-muted);
    margin-bottom: 0;
  }

  .provenance-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem 1.5rem;
    margin: 0 0 1.5rem;
  }

  .provenance-grid dt {
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ink-faint);
    margin-bottom: 0.2rem;
  }

  .provenance-grid dd {
    margin: 0;
    font-size: 0.93rem;
    overflow-wrap: anywhere;
  }

  .hash {
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  .provenance-notes {
    font-size: 0.88rem;
    color: var(--ink-muted);
    padding-left: 1.1rem;
    margin-bottom: 0;
  }

  .callout ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .callout li {
    font-size: 0.92rem;
  }
</style>
