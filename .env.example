# USPTO Open Data Portal API key.
# Only required if using the Bulk Datasets API to automate downloads.
# Obtain at https://data.uspto.gov/apis/getting-started (requires USPTO.gov
# account + ID.me identity verification). Passed as the X-API-KEY header.
USPTO_ODP_API_KEY=

# CourtListener token — optional, small illustrative sample only.
# https://www.courtlistener.com/help/api/rest/
COURTLISTENER_TOKEN=
