# Anthropic API key — server-side only, never exposed to the browser.
# Used by the pipeline's benchmark harness and by the /ask serverless route.
# https://console.anthropic.com — set a monthly spend limit before use.
ANTHROPIC_API_KEY=

# Kaggle credentials are read from %USERPROFILE%\.kaggle\kaggle.json by the
# official client. Set these instead only if you prefer environment variables.
# https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=
